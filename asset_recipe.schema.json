{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactical-code-rift.local/schemas/asset-recipe.schema.json",
  "title": "Tactical Code Rift Asset Recipe",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "source", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status": { "enum": ["candidate", "runtime-trial", "approved", "rejected", "blocked"] },
    "source": {
      "type": "object",
      "required": ["path", "author", "licenseStatus"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "licenseStatus": { "enum": ["cleared", "pending", "blocked"] },
        "identityReference": { "type": "string" }
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation"],
        "additionalProperties": false,
        "properties": {
          "operation": { "enum": ["copy", "crop-alpha", "resize", "split-sheet", "connected-component-cleanup", "runtime-assignment"] },
          "parameters": { "type": "object" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["character", "background", "ui", "fx", "audio", "manifest"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["requiredBy"],
      "properties": {
        "requiredBy": { "const": "Art Director" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string" }
      }
    }
  }
}
